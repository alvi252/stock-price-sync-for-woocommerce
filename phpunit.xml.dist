<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         executionOrder="random"
         beStrictAboutOutputDuringTests="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src/Feed</directory>
            <file>src/Sync/Change.php</file>
            <file>src/Sync/DiffCalculator.php</file>
            <file>src/Sync/ProductSnapshot.php</file>
            <file>src/Sync/SyncOptions.php</file>
            <file>src/Sync/SyncReport.php</file>
        </include>
    </source>
</phpunit>
