#. Plugin Name of the plugin
#: stock-price-sync-for-woocommerce.php
msgid "Stock & Price Sync for WooCommerce"
msgstr ""

#. Description of the plugin
#: stock-price-sync-for-woocommerce.php
msgid "Keeps WooCommerce stock levels and prices in sync with a supplier feed or ERP export (CSV or JSON), matched by SKU. Preview, schedule, log and WP-CLI included."
msgstr ""

#. Author of the plugin
#: stock-price-sync-for-woocommerce.php
msgid "Aleks T."
msgstr ""

